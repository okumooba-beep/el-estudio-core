# Copia este archivo a .env.local y completa con las credenciales de tu proyecto Supabase.
# Sin estas variables, LifeOS sigue funcionando: los datos se guardan localmente
# en el dispositivo hasta que exista un proyecto Supabase real.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fase 1 (push real): clave PÚBLICA de VAPID (applicationServerKey de
# pushManager.subscribe()). Solo la pública va acá — viaja al bundle del
# cliente. La privada NUNCA va en un archivo VITE_*: es un secret del lado
# del Edge Function (ver el comentario de deploy en
# supabase/functions/send-test-push/index.ts).
VITE_VAPID_PUBLIC_KEY=
